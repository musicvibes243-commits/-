# Для российского хостинга (Timeweb). На Netlify этот файл не нужен.

# Один адрес для Метрики и рекламы: www переадресуем на адрес без www.
# Переход на https включается в панели хостинга, здесь его нет —
# за прокси хостинга такое правило легко зацикливается.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP_HOST} ^www\.aykoweb\.ru$ [NC]
  RewriteRule ^ https://aykoweb.ru%{REQUEST_URI} [L,R=301]
</IfModule>

# Скриншоты работ не меняются — пусть браузер держит их год.
# Если замените картинку, дайте ей новое имя.
<IfModule mod_headers.c>
  <FilesMatch "\.(jpg|jpeg|png|webp|svg)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set X-Frame-Options "SAMEORIGIN"
</IfModule>
